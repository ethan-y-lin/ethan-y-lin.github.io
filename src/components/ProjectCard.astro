---
type Props = {
  title: string;
  description: string;
  href?: string;
  image?: string;
  imageAlt?: string;
  tags?: string[];
  year?: string | number;
  status?: string;
  links?: {
    label: string;
    href: string;
  }[];
};

const {
  title,
  description,
  href,
  image,
  imageAlt = "",
  tags = [],
  year,
  status,
  links = [],
} = Astro.props;
---

<article class="group overflow-hidden rounded-2xl border border-neutral-200 bg-white transition hover:border-neutral-300 hover:bg-neutral-50/90 dark:border-neutral-800 dark:bg-neutral-950 dark:hover:border-neutral-600 dark:hover:bg-neutral-900/70">
  {image && (
    <a href={href ?? "#"} class="block overflow-hidden border-b border-neutral-200 dark:border-neutral-800">
      <img
        src={image}
        alt={imageAlt || title}
        class="aspect-video w-full object-cover transition duration-300 group-hover:scale-[1.03]"
        loading="lazy"
      />
    </a>
  )}

  <div class="space-y-3 py-3.5">
    <div class="space-y-2">
      <div class="flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
        {year && <span>{year}</span>}
        {year && status && <span>·</span>}
        {status && (
          <span class="rounded-full border border-neutral-300 px-2 py-0.5 dark:border-neutral-700">
            {status}
          </span>
        )}
      </div>

      <h2 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
        {href ? (
          <a href={href} class="hover:text-neutral-950 dark:hover:text-white">
            {title}
          </a>
        ) : (
          title
        )}
      </h2>

      <p class="line-clamp-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">
        {description}
      </p>
    </div>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
            {tag}
          </span>
        ))}
      </div>
    )}

    {(href || links.length > 0) && (
      <div class="flex flex-wrap gap-3 pt-1 text-sm">
        {href && (
          <a
            href={href}
            class="font-medium text-neutral-900 underline underline-offset-4 hover:text-neutral-950 dark:text-neutral-100 dark:hover:text-white"
          >
            View project
          </a>
        )}

        {links.map((link) => (
          <a
            href={link.href}
            class="text-neutral-500 underline underline-offset-4 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
