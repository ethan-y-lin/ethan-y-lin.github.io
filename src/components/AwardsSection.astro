---
type Award = {
  year: string | number;
  title: string;
  description?: string;
  href?: string;
};

type Props = {
  awards: Award[];
  title?: string;
};

const { awards, title = "Awards" } = Astro.props;
---

<section class="content-section">
  <div>
    <h2 class="section-title">
      {title}
    </h2>
  </div>

  <div class="awards-list">
    <ul>
      {awards.map((award) => (
        <li class="award-item">
          <span class="award-name">
            {award.href ? (
              <a
                href={award.href}
                class="award-link"
                target={award.href.startsWith("http") ? "_blank" : undefined}
                rel={award.href.startsWith("http") ? "noreferrer" : undefined}
              >
                {award.title}
              </a>
            ) : (
              <span class="award-title">{award.title}</span>
            )}

            {award.description && <span> — {award.description}</span>}
          </span>
          <span class="award-year">{award.year}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
