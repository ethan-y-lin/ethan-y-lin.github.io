---
type Award = {
  year: string | number;
  title: string;
  description?: string;
  href?: string;
};

type Props = {
  awards: Award[];
  title?: string;
};

const { awards, title = "Awards" } = Astro.props;
---

<section class="space-y-5">
  <div>
    <h2 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
      {title}
    </h2>
  </div>

  <div class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-950">
    <ul class="space-y-3 text-sm text-neutral-600 dark:text-neutral-300">
      {awards.map((award) => (
        <li>
          <span class="text-neutral-500 dark:text-neutral-500">
            {award.year}
          </span>
          {" · "}
          {award.href ? (
            <a
              href={award.href}
              class="font-medium text-neutral-800 underline underline-offset-4 hover:text-neutral-950 dark:text-neutral-200 dark:hover:text-white"
              target={award.href.startsWith("http") ? "_blank" : undefined}
              rel={award.href.startsWith("http") ? "noreferrer" : undefined}
            >
              {award.title}
            </a>
          ) : (
            <span class="font-medium text-neutral-800 dark:text-neutral-200">
              {award.title}
            </span>
          )}

          {award.description && (
            <span class="text-neutral-600 dark:text-neutral-400">
              {" — "}
              {award.description}
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>