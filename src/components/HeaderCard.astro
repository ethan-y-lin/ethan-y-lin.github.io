---
type Link = {
  label: string;
  href: string;
};

type Props = {
  name: string;
  title: string;
  affiliation?: string;
  location?: string;
  photo?: string;
  photoAlt?: string;
  interests?: string[];
  links?: Link[];
};

const {
  name,
  title,
  affiliation,
  location,
  photo,
  photoAlt = "",
  interests = [],
  links = [],
} = Astro.props;
---

<section class="border-b border-[var(--rule)] pb-5 md:pb-6">
    <div class="grid gap-5 md:grid-cols-[205px_1fr] md:items-start">
      {photo && (
        <div class="mx-auto md:mx-0">
          <img
            src={photo}
            alt={photoAlt || name}
            class="h-72 w-48 rounded-[1.75rem] object-cover grayscale-[10%]"
          />
        </div>
      )}
  
      <div class="space-y-3">
        <div>
          <div>
            <h1 class="text-5xl font-normal tracking-tight text-[var(--ink)] md:text-6xl">
              {name}
            </h1>
  
            <p class="profile-title">
              {title}
            </p>
  
            {(affiliation || location) && (
              <p class="mt-1 text-sm text-[var(--muted)]">
                {affiliation}{affiliation && location ? " · " : ""}{location}
              </p>
            )}
          </div>
        </div>
  
        <div class="max-w-3xl text-[0.95rem] leading-7 text-[var(--muted)]">
          <slot />
        </div>
  
        {interests.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {interests.map((interest) => (
              <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
                {interest}
              </span>
            ))}
          </div>
        )}
  
        {links.length > 0 && (
          <div class="flex flex-wrap gap-3 text-sm">
            {links.map((link) => (
              <a
                href={link.href}
                class="border-b border-[var(--rule)] pb-1 text-[var(--ink)] transition hover:border-[var(--accent)] hover:text-[var(--accent)]"
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
