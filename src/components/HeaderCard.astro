---
import ThemeToggle from "./ThemeToggle.astro";

type Link = {
  label: string;
  href: string;
};

type Props = {
  name: string;
  title: string;
  affiliation?: string;
  location?: string;
  photo?: string;
  photoAlt?: string;
  interests?: string[];
  links?: Link[];
};

const {
  name,
  title,
  affiliation,
  location,
  photo,
  photoAlt = "",
  interests = [],
  links = [],
} = Astro.props;
---

<section class="rounded-3xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-950 md:p-8">
    <div class="grid gap-8 md:grid-cols-[180px_1fr] md:items-start">
      {photo && (
        <div class="mx-auto md:mx-0">
          <img
            src={photo}
            alt={photoAlt || name}
            class="h-60 w-40 rounded-3xl object-cover ring-1 ring-neutral-200 dark:ring-neutral-700"
          />
        </div>
      )}
  
      <div class="space-y-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-4xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
              {name}
            </h1>
  
            <p class="mt-2 text-lg text-neutral-700 dark:text-neutral-300">
              {title}
            </p>
  
            {(affiliation || location) && (
              <p class="mt-1 text-sm text-neutral-500 dark:text-neutral-400">
                {affiliation}{affiliation && location ? " · " : ""}{location}
              </p>
            )}
          </div>
  
          <div class="shrink-0">
            <ThemeToggle />
          </div>
        </div>
  
        <p class="max-w-3xl text-sm leading-7 text-neutral-600 dark:text-neutral-300">
          <slot />
        </p>
  
        {interests.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {interests.map((interest) => (
              <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
                {interest}
              </span>
            ))}
          </div>
        )}
  
        {links.length > 0 && (
          <div class="flex flex-wrap gap-3 text-sm">
            {links.map((link) => (
              <a
                href={link.href}
                class="rounded-full border border-neutral-200 px-4 py-2 text-neutral-700 transition hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-900"
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>