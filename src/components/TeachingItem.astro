---
type Props = {
  course: string;
  role: string;
  institution: string;
  date: string;
  description?: string;
};

const { course, role, institution, date, description } = Astro.props;
---

<div class="teaching-item">
  <div class="teaching-row">
    <h3 class="teaching-course">{course}</h3>
    <p class="teaching-meta">
      {role} · {institution}
    </p>
    <p class="teaching-meta">{date}</p>
  </div>

  {description && (
    <p class="teaching-description">
      {description}
    </p>
  )}
</div>
