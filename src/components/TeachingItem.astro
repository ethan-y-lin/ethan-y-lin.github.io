---
type Props = {
  course: string;
  role: string;
  institution: string;
  date: string;
  description?: string;
};

const { course, role, institution, date, description } = Astro.props;
---

<div class="rounded-2xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-950">
  <div class="flex flex-col gap-1 md:flex-row md:items-start md:justify-between">
    <div>
      <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">{course}</h3>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">
        {role} · {institution}
      </p>
    </div>

    <p class="text-sm text-neutral-500 dark:text-neutral-500">{date}</p>
  </div>

  {description && (
    <p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-300">
      {description}
    </p>
  )}
</div>