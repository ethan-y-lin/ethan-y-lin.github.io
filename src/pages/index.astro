---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import ResearchCard from "../components/ResearchCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Ethan Lin</div>
    <div class="text-xl py-1">eyl45@cornell.edu</div>
    <div class="py-2">
      <text class="text-lg">
        I am a 4th year undergraduate student pursuing a major in Computer Science and minor in Electrical and Computer Engineering at Cornell. 
        I am extremely fortunate to work with Professor Jennifer J. Sun. Previously, I worked with Professor Donald Greenberg on
        virtual reality and 3D modeling projects.
        <br>
        <br>
        I am interested in research in the areas of computer graphics, vision, and AI4Science. I have recently
        worked on advancing visual concept learning with VLMs and applying video foundation models for animal behavior 
        analysis. Currently, I am working on developing AI Agents for scientific applications.
      </text>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Research</div>
  </div>

  <ResearchCard
    title="Simple Agents Outperform Experts in Biomedical Imaging Workflow Optimization"
    img="/sciseek.png"
    authors="Xuefei Wang, Kai A. Horstmann, <b>Ethan Lin</b>, Jonathan Chen, Alexander R. Farhang, Sophia Stiles, Atharva Sehgal, Jonathan Light, David Van Valen, Yisong Yue, Jennifer J. Sun",
    venue="In submission...",
    links={[
            ["Paper","https://www.arxiv.org/pdf/2512.06006"],
            ["Project Page", "https://sites.google.com/view/simple-agent-opt/home"],
            ["Code", "https://github.com/xuefei-wang/simple-agent-opt"],
            ["arXiv", "https://arxiv.org/abs/2512.06006"]
          ]}
  />
  <div class="divider my-0"></div>
  <ResearchCard
    title="WildFin: An In-the-Wild Video Dataset from Underwater Ecology Pipelines",
    img="/wildfin.png"
    authors="Abigail Grassick, Jerome Tze-Hou Hsu, <b>Ethan Lin</b>, Max Whitton, Madelyn Hair, Liam Gutierrez, Haozheng Yu, Kristin Branson, Vivek Jayaraman, Michael A. Gil, Andrew M. Hein, Jennifer J. Sun",
    venue="In submission...",
    links={[
            ["Coming Soon!","https://ethan-y-lin.github.io"]
          ]}
  />
  <div class="divider my-0"></div>
  <ResearchCard
    title="Beyond Accuracy: Metrics that Uncover what makes a 'Good' Visual Descriptor"
    img="/fig_concept_main.png"
    authors="<b>Ethan Lin*</b>, Linxi Zhao, Atharva Sehgal, Jennifer J. Sun",
    venue="VisCon @ CVPR 2025 <b>[Best Poster Award]</b>"
    links={[
            ["Paper","https://arxiv.org/pdf/2507.03542"],
            ["Project Page", "https://ethan-y-lin.github.io/beyond-accuracy-project-page/"],
            ["Code", "https://github.com/ethan-y-lin/beyond_accuracy"],
            ["arXiv", "https://arxiv.org/abs/2507.03542"]
          ]}
  />
<div>
  <div class="text-3xl w-full font-bold mb-6 mt-10">Teaching Experience</div>

  <div class="border-l-4 border-primary pl-6 space-y-5">
    <div>
      <h3 class="text-lg font-semibold">CS 4782: Introduction to Deep Learning</h3>
      <p class="text-sm text-gray-600">TA Spring 2025</p>
    </div>
    <div>
      <h3 class="text-lg font-semibold">CS 4620: Introduction to Computer Graphics</h3>
      <p class="text-sm text-gray-600">TA Fall 2025</p>
    </div>

    <div>
      <h3 class="text-lg font-semibold">CS 3780: Introduction to Machine Learning</h3>
      <p class="text-sm text-gray-600">TA Fall 2024 & Spring 2025 </p>
    </div>

    <div>
      <h3 class="text-lg font-semibold">CS 1620: Visual Imaging in the Electronic Age</h3>
      <p class="text-sm text-gray-600">TA Fall 2024</p>
    </div>

    <div>
      <h3 class="text-lg font-semibold">CS 2110: Object Oriented Programming and Data Structures</h3>
      <p class="text-sm text-gray-600">Course Consultant Spring 2024</p>
    </div>
  </div>
</div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Projects</div>
  </div>
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Softbody Physics Simulator"
    video="/softbody_demo_video.mp4"
    desc="This project models softbody interactions using particle-spring systems. \
    This was the top submission for a creative project in Cornell's Graphics course (CS4620)."
    url={""}
    target="_self"
    badge=""
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Taichi Pathtracer"
    video="/pathtracer_diamond.mov"
    desc="This project implements an efficient pathtracer in Taichi that renders a diamond. The pathtracer supports \
          refraction, fresnel reflection, normal mapping, texture mapping, etc."
    url={""}
    target="_self"
    badge=""
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Infinite Zelda"
    video="/sunlight.mov"
    desc="This project uses rasterization to render a mini game that is inspired by Zelda. \
     Customized shaders are created to simulate grass, trees, terrain, etc."
    url={""}
    target="_self"
    badge=""
  />

<div>
  <div class="text-3xl w-full font-bold mb-6 mt-10">Awards</div>

  <div class="border-l-4 border-primary pl-6 space-y-5">
    <div>
      <h3 class="text-lg font-semibold">CRA Outstanding Undergraduate Researcher Award Honorable Mention 2025-2026 </h3>
    </div>
    <div>
      <h3 class="text-lg font-semibold">Best Poster Award - Visual Concepts Workshop CVPR 2025</h3>
    </div>

    <div>
      <h3 class="text-lg font-semibold">Dean's List All Semesters</h3>
    </div>
  </div>
</div>


</BaseLayout>
