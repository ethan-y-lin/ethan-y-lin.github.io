---

<BaseLayout title="Ethan Lin">
  <div class="space-y-14">
    <HeaderCard
      name="Ethan Lin"
      title="Incoming CMS PhD Student at Caltech"
      affiliation=""
      location=""
      photo="/images/bio_photo.png"
      interests={[
      ]}
      links={[
        { label: "Email", href: "mailto:eyl45@cornell.edu" },
        { label: "GitHub", href: "https://github.com/ethan-y-lin" },
        { label: "Google Scholar", href: "https://scholar.google.com/citations?user=cpF0bJUAAAAJ&hl=en" },
        { label: "CV", href: "/files/CV.pdf" },
      ]}
    >
    <p class="max-w-3xl text-sm leading-7 text-neutral-600 dark:text-neutral-300">
		I am an incoming CMS PhD student at Caltech, where I will be working with
		<a
		  href="https://www.yisongyue.com/"
		  class="font-medium text-amber-700 underline underline-offset-4 hover:text-amber-800 dark:text-amber-300 dark:hover:text-amber-200"
		  target="_blank"
		  rel="noreferrer"
		>
		  Yisong Yue
		</a>.
		I am completing my undergraduate degree in Computer Science at Cornell University,
		where I was fortunate to be advised by
		<a
		  href="https://jenjsun.com/"
		  class="font-medium text-amber-700 underline underline-offset-4 hover:text-amber-800 dark:text-amber-300 dark:hover:text-amber-200"
		  target="_blank"
		  rel="noreferrer"
		>
		  Jennifer J. Sun
		</a>.
		I'm broadly interested in AI for scientific discovery, currently focused on
		leveraging agents for automating bottlenecks in scientific analysis pipelines.
	  </p>
	</HeaderCard>
    <NewsList items={news} />

	<section class="space-y-5">
		<div class="flex items-end justify-between gap-4">
		  <div>
			<h2 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
			  Publications
			</h2>
			<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
			  Selected papers and ongoing research.
			</p>
		  </div>
	  
		  {publications.some((pub) => !pub.selected) && (
			<button
			  id="publications-toggle"
			  type="button"
			  class="shrink-0 text-sm font-medium text-neutral-600 underline underline-offset-4 transition hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white"
			  aria-expanded="false"
			  aria-controls="publications-list"
			>
			  Show all publications
			</button>
		  )}
		</div>
	  
		<div id="publications-list">
			{publications.map((pub) => (
			  <div
				class:list={[
				  "overflow-hidden transition-all duration-500 ease-in-out",
				  pub.selected
					? "mb-5 max-h-[1000px] translate-y-0 opacity-100"
					: "mb-0 max-h-0 -translate-y-2 opacity-0 pointer-events-none",
				]}
				data-publication
				data-selected={pub.selected ? "true" : "false"}
			  >
				<ResearchCard {...pub} />
			  </div>
			))}
		  </div>
	</section>
	  
	<script>
		const button = document.getElementById("publications-toggle");
		const publicationItems = document.querySelectorAll("[data-publication]");
	  
		let expanded = false;
	  
		button?.addEventListener("click", () => {
		  expanded = !expanded;
	  
		  publicationItems.forEach((item) => {
			const isSelected = item.getAttribute("data-selected") === "true";
			if (isSelected) return;
	  
			item.classList.toggle("mb-0", !expanded);
			item.classList.toggle("max-h-0", !expanded);
			item.classList.toggle("-translate-y-2", !expanded);
			item.classList.toggle("opacity-0", !expanded);
			item.classList.toggle("pointer-events-none", !expanded);
	  
			item.classList.toggle("mb-5", expanded);
			item.classList.toggle("max-h-[1000px]", expanded);
			item.classList.toggle("translate-y-0", expanded);
			item.classList.toggle("opacity-100", expanded);
		  });
	  
		  button.textContent = expanded
			? "Show selected publications"
			: "Show all publications";
	  
		  button.setAttribute("aria-expanded", String(expanded));
		});
	  </script>

    <section class="space-y-5">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Teaching</h2>
      </div>

      <div class="space-y-4">
        {teachings.map((teaching) => (
          <TeachingItem {...teaching} />
        ))}
      </div>
    </section>

    <AwardsSection awards={awards} />
  </div>
</BaseLayout>